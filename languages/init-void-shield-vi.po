#. Description
msgid "Zero-DB, zero-external-JS honeypot anti-spam for WordPress comments, core forms, and popular form plugins. Invisible to humans, a void to bots."
msgstr "Chống spam bằng honeypot cho form bình luận, các form lõi của WordPress và những plugin form phổ biến — không dùng cơ sở dữ liệu, không JavaScript bên ngoài. Vô hình với người dùng, vô tình với bot."

#: includes/field-guard.php:151
msgid "If you are human, please leave this field blank."
msgstr "Nếu bạn là người thật, xin vui lòng BỎ TRỐNG ô này."

#: includes/field-guard.php:155
msgid "Do not check this box."
msgstr "Đừng check vào ô này."

#: includes/honeypot-core.php:45
msgid "Your comment is awaiting moderation."
msgstr "Bình luận của bạn đang chờ kiểm duyệt."

#: includes/honeypot-core.php:50
msgid "Success"
msgstr "Thành công"

#: includes/honeypot-core.php:162
msgid "Comments submitted via the REST API are not accepted on this site."
msgstr "Bình luận gửi qua REST API không được chấp nhận trên site này."

#: includes/integration-gravityforms.php:72
msgid "Blocked by honeypot guard."
msgstr "Bị chặn bởi honeypot guard."

#: includes/integration-wpforms.php:69
msgid "Something went wrong. Please try again."
msgstr "Đã có lỗi xảy ra. Vui lòng thử lại."

