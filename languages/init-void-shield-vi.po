msgid "Other"
msgstr "Khác"

#: includes/settings-page.php:276
msgid "Filled a hidden trap field"
msgstr "Điền vào ô bẫy ẩn"

#: includes/settings-page.php:277
msgid "Missing or invalid JS token"
msgstr "Thiếu hoặc sai token JS"

#: includes/settings-page.php:278
msgid "Headless browser detected"
msgstr "Phát hiện trình duyệt headless"

#: includes/settings-page.php:279
msgid "Missing time token"
msgstr "Thiếu token thời gian"

#: includes/settings-page.php:280
msgid "Invalid time token"
msgstr "Token thời gian không hợp lệ"

#: includes/settings-page.php:281
msgid "Submitted too fast"
msgstr "Gửi quá nhanh"

#: includes/settings-page.php:282
msgid "No user agent header"
msgstr "Không có header User-Agent"

#: includes/settings-page.php:283
msgid "Invalid post ID"
msgstr "ID bài viết không hợp lệ"

#: includes/settings-page.php:284
msgid "REST API endpoint blocked"
msgstr "Endpoint REST API bị chặn"

#: includes/settings-page.php:296
msgid "Detected on this site."
msgstr "Đã phát hiện trên site này."

#: includes/settings-page.php:300
msgid "Not detected on this site. Install and activate it first."
msgstr "Không phát hiện trên site này. Hãy cài đặt và kích hoạt plugin đó trước."

#: includes/settings-page.php:339
msgid "Statistics have been reset."
msgstr "Đã đặt lại thống kê."

#: includes/settings-page.php:359
msgid "Enable Init Void Shield"
msgstr "Bật Init Void Shield"

#: includes/settings-page.php:365
msgid "Activate the honeypot defense on comment forms."
msgstr "Kích hoạt hệ thống phòng thủ honeypot trên form bình luận."

#: includes/settings-page.php:373
msgid "Apply to Logged-in Users"
msgstr "Áp dụng cho người dùng đã đăng nhập"

#: includes/settings-page.php:379
msgid "Also verify comments from logged-in users."
msgstr "Cũng xác minh bình luận từ người dùng đã đăng nhập."

#: includes/settings-page.php:382
msgid "By default, logged-in users are trusted and bypass all checks. Enable this if your site has open registration or untrusted members."
msgstr "Mặc định, người dùng đã đăng nhập được tin tưởng và bỏ qua mọi kiểm tra. Bật tùy chọn này nếu site của bạn cho đăng ký công khai hoặc có thành viên không đáng tin."

#: includes/settings-page.php:390
msgid "Minimum Submit Time"
msgstr "Thời gian gửi tối thiểu"

#: includes/settings-page.php:399
msgid "seconds"
msgstr "giây"

#: includes/settings-page.php:401
msgid "Comments submitted faster than this will be rejected. Humans need time to read and type."
msgstr "Bình luận gửi nhanh hơn ngưỡng này sẽ bị từ chối. Con người cần thời gian để đọc và gõ."

#: includes/settings-page.php:409
msgid "JavaScript Token Delay"
msgstr "Độ trễ Token JavaScript"

#: includes/settings-page.php:418
msgid "milliseconds"
msgstr "mili giây"

#: includes/settings-page.php:420
msgid "Delay before the hidden JS token is injected. Catches headless browsers that submit instantly."
msgstr "Độ trễ trước khi token JS ẩn được bơm vào. Bắt các trình duyệt headless gửi ngay lập tức."

#: includes/settings-page.php:428
msgid "Block REST API Comments"
msgstr "Chặn bình luận qua REST API"

#: includes/settings-page.php:434
msgid "Reject comments submitted directly through the REST API (wp/v2/comments)."
msgstr "Từ chối bình luận gửi trực tiếp qua REST API (wp/v2/comments)."

#: includes/settings-page.php:437
msgid "The honeypot and JS token checks above only cover the classic comment form; REST API submissions bypass them entirely. Enable this only if your site does not rely on a headless app or other legitimate client that posts comments via the REST API."
msgstr "Các kiểm tra honeypot và token JS ở trên chỉ áp dụng cho form bình luận cổ điển; bình luận gửi qua REST API sẽ né hoàn toàn các kiểm tra đó. Chỉ bật tùy chọn này nếu site của bạn không có app headless hay client hợp lệ nào khác gửi bình luận qua REST API."

#: includes/settings-page.php:443
msgid "WordPress Core Forms"
msgstr "Các form lõi WordPress"

#: includes/settings-page.php:445
msgid "Optional honeypot protection for the default WordPress login, registration, and lost-password forms at wp-login.php. Disabled by default, since these guard authentication itself — review your setup after enabling."
msgstr "Bảo vệ honeypot tùy chọn cho form đăng nhập, đăng ký và quên mật khẩu mặc định của WordPress tại wp-login.php. Mặc định tắt vì đây là các form liên quan trực tiếp đến xác thực — hãy kiểm tra lại cấu hình sau khi bật."

#: includes/settings-page.php:451
msgid "Guard Login Form"
msgstr "Bảo vệ form Đăng nhập"

#: includes/settings-page.php:457
msgid "Protect the default WP login form against automated login attempts."
msgstr "Bảo vệ form đăng nhập mặc định của WP khỏi các lần đăng nhập tự động."

#: includes/settings-page.php:465
msgid "Guard Registration Form"
msgstr "Bảo vệ form Đăng ký"

#: includes/settings-page.php:471
msgid "Protect the default WP registration form (wp-login.php?action=register)."
msgstr "Bảo vệ form đăng ký mặc định của WP (wp-login.php?action=register)."

#: includes/settings-page.php:474
msgid "Only applies if user registration is open. Multisite signup (wp-signup.php) uses a different form and is not covered."
msgstr "Chỉ áp dụng khi cho phép đăng ký thành viên. Form đăng ký Multisite (wp-signup.php) dùng giao diện khác và không được hỗ trợ."

#: includes/settings-page.php:482
msgid "Guard Lost Password Form"
msgstr "Bảo vệ form Quên mật khẩu"

#: includes/settings-page.php:488
msgid "Protect the default WP lost-password form."
msgstr "Bảo vệ form quên mật khẩu mặc định của WP."

#: includes/settings-page.php:494
msgid "Form Plugin Integrations"
msgstr "Tích hợp Plugin Form"

#: includes/settings-page.php:496
msgid "Optional honeypot protection for popular third-party form plugins. Each toggle only takes effect if the corresponding plugin is active."
msgstr "Bảo vệ honeypot tùy chọn cho các plugin form phổ biến của bên thứ ba. Mỗi công tắc chỉ có tác dụng nếu plugin tương ứng đang được kích hoạt."

#: includes/settings-page.php:508
msgid "Add the honeypot guard to all Contact Form 7 forms."
msgstr "Thêm honeypot guard vào tất cả form Contact Form 7."

#: includes/settings-page.php:523
msgid "Add the honeypot guard to all WPForms forms."
msgstr "Thêm honeypot guard vào tất cả form WPForms."

#: includes/settings-page.php:538
msgid "Add the honeypot guard to all Gravity Forms forms."
msgstr "Thêm honeypot guard vào tất cả form Gravity Forms."

#: includes/settings-page.php:545
msgid "Advanced Protection"
msgstr "Bảo vệ nâng cao"

#: includes/settings-page.php:550
msgid "Custom Field Prefix"
msgstr "Tiền tố Field tùy chỉnh"

#: includes/settings-page.php:560
msgid "Prefix used to build the hidden honeypot field names (lowercase letters, numbers, underscore only). Change this if you suspect a spammer has targeted your site specifically."
msgstr "Tiền tố dùng để tạo tên các field honeypot ẩn (chỉ gồm chữ thường, số, dấu gạch dưới). Đổi giá trị này nếu bạn nghi ngờ có kẻ spam nhắm riêng vào site của bạn."

#: includes/settings-page.php:568
msgid "CSS Trap Rotation"
msgstr "Xoay vòng CSS Bẫy"

#: includes/settings-page.php:574
msgid "Randomize the CSS technique and field order used to hide honeypot traps on every render."
msgstr "Ngẫu nhiên hóa kỹ thuật CSS và thứ tự field dùng để ẩn bẫy honeypot mỗi lần hiển thị."

#: includes/settings-page.php:577
msgid "Makes it harder for CSS-aware bots to learn a single fixed pattern. Traps remain invisible to humans either way."
msgstr "Khiến các bot biết đọc CSS khó học được một khuôn mẫu cố định hơn. Dù bật hay tắt, bẫy vẫn luôn vô hình với người dùng."

#: includes/settings-page.php:585
msgid "Headless Browser Detection"
msgstr "Phát hiện Trình duyệt Headless"

#: includes/settings-page.php:591
msgid "Flag common automation signals (navigator.webdriver, zero-size browser window) picked up by the JS token script."
msgstr "Đánh dấu các dấu hiệu tự động hóa phổ biến (navigator.webdriver, cửa sổ trình duyệt kích thước 0) mà script token JS phát hiện được."

#: includes/settings-page.php:594
msgid "Lightweight, client-side only, no external calls. Disable this if you use browser-automation tools to test submissions on your own site."
msgstr "Nhẹ, chỉ chạy phía client, không gọi ra bên ngoài. Tắt tùy chọn này nếu bạn dùng công cụ tự động hóa trình duyệt để test gửi form trên chính site của mình."

#: includes/settings-page.php:600
msgid "Statistics"
msgstr "Thống kê"

#: includes/settings-page.php:605
msgid "Track Blocked Submissions"
msgstr "Theo dõi lượt gửi bị chặn"

#: includes/settings-page.php:611
msgid "Keep lightweight counters of blocked submissions, shown below."
msgstr "Giữ bộ đếm nhẹ các lượt gửi bị chặn, hiển thị bên dưới."

#: includes/settings-page.php:614
msgid "Stored as a single, non-autoloaded option. No per-submission logs or personal data are kept."
msgstr "Lưu dưới dạng một option duy nhất, không autoload. Không lưu log chi tiết từng lượt gửi hay dữ liệu cá nhân nào."

#: includes/settings-page.php:638
msgid "Blocked Submissions"
msgstr "Lượt gửi bị chặn"

#: includes/settings-page.php:641
msgid "Total blocked:"
msgstr "Tổng số bị chặn:"

#. translators: %s: human-readable time difference, e.g. "3 hours".
#: includes/settings-page.php:648
msgid "last blocked %s ago"
msgstr "lần chặn gần nhất cách đây %s"

#: includes/settings-page.php:656
msgid "By channel:"
msgstr "Theo kênh:"

#: includes/settings-page.php:670
msgid "By reason:"
msgstr "Theo lý do:"

#: includes/settings-page.php:684
msgid "No submissions have been blocked yet."
msgstr "Chưa có lượt gửi nào bị chặn."

#: includes/settings-page.php:690
msgid "Reset Statistics"
msgstr "Đặt lại thống kê"

#: includes/wp-core-forms.php:65
msgid "Invalid login attempt."
msgstr "Lần đăng nhập không hợp lệ."

#: includes/wp-core-forms.php:112
msgid "Registration could not be completed. Please try again."
msgstr "Không thể hoàn tất đăng ký. Vui lòng thử lại."

#: includes/wp-core-forms.php:167
msgid "Your request could not be processed. Please try again."
msgstr "Không thể xử lý yêu cầu của bạn. Vui lòng thử lại."

