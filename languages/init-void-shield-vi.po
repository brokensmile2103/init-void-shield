msgid "No submissions have been blocked yet."
msgstr "Chưa có lượt gửi nào bị chặn."

#: includes/settings-page.php:910
msgid "Reset Statistics"
msgstr "Đặt lại thống kê"

#: includes/stats.php:145
msgid "Init Void Shield – Blocked Submissions"
msgstr "Init Void Shield – Lượt gửi đã chặn"

#: includes/stats.php:171
