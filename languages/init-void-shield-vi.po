msgstr "Kênh bị chặn nhiều nhất"

#: includes/stats.php:193
msgid "Top reasons"
msgstr "Lý do bị chặn nhiều nhất"

#: includes/stats.php:198
msgid "View full statistics & settings"
msgstr "Xem đầy đủ thống kê & cài đặt"

#: includes/wp-core-forms.php:122
msgid "Invalid login attempt."
msgstr "Lần đăng nhập không hợp lệ."

#: includes/wp-core-forms.php:262 includes/wp-core-forms.php:333
msgid "Your request could not be processed. Please try again."
msgstr "Không thể xử lý yêu cầu của bạn. Vui lòng thử lại."

#: init-void-shield.php:55
msgid "Settings"
msgstr "Cài đặt"
